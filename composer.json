{
    "name": "josrom/monster-hunter-board-game",
    "type": "project",
    "description": "",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ajcastro/eager-load-pivot-relations": "^0.3.0",
        "guzzlehttp/guzzle": "^8.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.0",
        "laravel/nightwatch": "^1.30",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.9",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.13",
        "meilisearch/meilisearch-php": "^1.1",
        "predis/predis": "^3.7",
        "pusher/pusher-php-server": "^7.2",
        "sentry/sentry-laravel": "^4.0",
        "socialiteproviders/discord": "^4.1",
        "socialiteproviders/github": "^4.1",
        "socialiteproviders/google": "^4.1",
        "spatie/cpu-load-health-check": "^1.0",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-translatable": "^6.5",
        "spatie/security-advisories-health-check": "^1.4",
        "tightenco/ziggy": "^2.6",
        "victord11/ssl-certification-health-check": "^1.0"
    },
    "require-dev": {
        "asbiin/localizator": "^1.1",
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "laravel-lang/common": "^6.0",
        "laravel-lang/lang": "^15.0",
        "laravel/boost": "^2.9",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-typescript-transformer": "^3.3",
        "testmonitor/laravel-vue-i18n-generator": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pint": [
            "vendor/bin/pint --config=./pint.json"
        ],
        "coverage": [
            "vendor/bin/pest --coverage-html ./reports"
        ],
        "extract-translations": [
            "@php artisan localize es,en",
            "@php artisan translations:extract-vue"
        ],
        "generate-translations": [
            "@php artisan localize es,en",
            "@php artisan translations:extract-vue",
            "@php artisan vue:translations --output=resources/js/vue-i18n-locales.generated.js"
        ],
        "generate-types": [
            "@php artisan typescript:transform",
            "@php artisan ziggy:generate --types-only resources/js/types/ziggy.d.ts"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.5.12"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
