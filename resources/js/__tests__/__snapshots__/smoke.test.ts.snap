        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <div class="mh-card cursor-default gap-3 p-5">
            <div class="flex items-center gap-3"><span class="flex h-10 w-10 min-h-10 min-w-10 items-center justify-center overflow-hidden rounded-full bg-gray-300 dark:bg-gray-900"><img src="/images/monsters/anjanath.png" alt="Anjanath" class="h-8 w-8 object-contain"></span><span class="mh-card-name flex-1 text-xl">Anjanath</span><span class="mh-value">Brute Wyvern</span><span class="mh-value">Core Box</span></div><a href="/wiki.monster.card" class="text-sm text-gray-600 underline dark:text-parchment-dim">View as card</a>
            <div class="mh-rule"></div>
            <!--v-if-->
            <div class="flex items-center gap-3 text-sm"><span class="mh-value">★ 3</span><span class="mh-value">♥ 250</span></div>
