                  <circle cx="20" cy="12" r="1.3" fill="#fff"></circle>
                </svg><span class="flex items-center gap-1"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10"><path fill="#dfcfb5" stroke="#8a7a67" stroke-width="1.5" stroke-linejoin="round" d="M5 4h14v9c0 3-2.5 5-3.5 6L12 22l-3.5-3C7.5 18 5 16 5 13z"></path></svg><span class="mh-value">15</span></span><span class="flex items-center gap-1"><svg fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 dark:text-gray-400"><path d="M12 1l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" transform="rotate(45 12 12)"></path></svg><span class="mh-value">1</span></span></div>
              <!--v-if-->
