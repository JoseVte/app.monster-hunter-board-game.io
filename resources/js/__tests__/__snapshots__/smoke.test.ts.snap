                  <circle cx="12" cy="4" r="1.3" fill="#fff"></circle>
                  <polygon points="12,16 16,20 12,24 8,20" fill="currentColor"></polygon>
                  <!--v-if-->
                  <polygon points="4,8 8,12 4,16 0,12" fill="currentColor"></polygon>
                  <!--v-if-->
                  <polygon points="20,8 24,12 20,16 16,12" fill="currentColor"></polygon>
                  <!--v-if-->
                </svg><span class="flex items-center gap-1"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10"><path fill="#dfcfb5" stroke="#8a7a67" stroke-width="1.5" stroke-linejoin="round" d="M5 4h14v9c0 3-2.5 5-3.5 6L12 22l-3.5-3C7.5 18 5 16 5 13z"></path></svg><span class="mh-value">18</span></span><span class="flex items-center gap-1"><svg fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 dark:text-gray-400"><path d="M12 1l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" transform="rotate(45 12 12)"></path></svg><span class="mh-value">1</span></span></div>
              <!--v-if-->
            </div>
            <div class="mh-rule mt-2"></div>
            <h3 class="mh-heading text-xs tracking-widest uppercase">Resistances</h3>
            <div class="flex flex-col gap-3">
              <div>
                <h4 class="mb-1 text-[0.65rem] font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Elements</h4>
                <div class="grid grid-cols-5 gap-3">
                  <div class="flex flex-col items-center gap-1" title="Fire"><img src="undefined/resources/images/types/fire.png" alt="Fire" class="h-5 w-5"><span class="flex gap-0.5 text-primary-500"><span>★</span><span>★</span><span>★</span></span></div>
                  <div class="flex flex-col items-center gap-1" title="Water"><img src="undefined/resources/images/types/water.png" alt="Water" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                  <div class="flex flex-col items-center gap-1" title="Thunder"><img src="undefined/resources/images/types/thunder.png" alt="Thunder" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                  <div class="flex flex-col items-center gap-1" title="Ice"><img src="undefined/resources/images/types/ice.png" alt="Ice" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                  <div class="flex flex-col items-center gap-1" title="Dragon"><img src="undefined/resources/images/types/dragon.png" alt="Dragon" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                </div>
              </div>
              <div>
                <h4 class="mb-1 text-[0.65rem] font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Status</h4>
                <div class="grid grid-cols-5 gap-3">
                  <div class="flex flex-col items-center gap-1" title="Paralysis"><img src="undefined/resources/images/icons/paralysis.png" alt="Paralysis" class="h-5 w-5"><span class="flex gap-0.5 text-primary-500"><span>★</span></span></div>
                  <div class="flex flex-col items-center gap-1" title="Poison"><img src="undefined/resources/images/icons/poison.webp" alt="Poison" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                  <div class="flex flex-col items-center gap-1" title="Sleep"><img src="undefined/resources/images/icons/sleep.svg" alt="Sleep" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                  <div class="flex flex-col items-center gap-1" title="Nitro"><img src="undefined/resources/images/icons/nitro.png" alt="Nitro" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                  <div class="flex flex-col items-center gap-1" title="Stun"><img src="undefined/resources/images/icons/stun.webp" alt="Stun" class="h-5 w-5"><span class="text-gray-400 dark:text-gray-600">✗</span></div>
                </div>
              </div>
            </div>
          </div>
          <div class="mh-card cursor-default mt-4 gap-3 p-5">
            <h3 class="mh-heading text-xs tracking-widest uppercase">Setup</h3>
            <p>Place three shrieker traps around the arena before the hunt begins.</p>
            <div class="mh-rule mt-2"></div>
            <h3 class="mh-heading text-xs tracking-widest uppercase">Rage Mode</h3>
            <div class="text-sm">
              <p class="font-semibold">Trigger</p>
              <p>Becomes enraged once reduced to half health.</p>
            </div>
          </div>
          <div class="mh-card cursor-default mt-4 gap-3 p-5">
            <h3 class="mh-heading text-xs tracking-widest uppercase">Reward Table</h3>
            <!-- The notched corners every other box on the wiki carries, rather than
         rounding: the two are alternatives, not a pair, so rounding and the
         overflow clip it needed are both gone with it.

         mh-notch rather than mh-frame: mh-frame's marks sit a pixel outside
         the border, which is fine on a plain panel but here the top corners
         land on the header row. mh-notch draws them flush with the inside of
         the border instead, in the accent colour rather than border-inherit,
         so they still read against the header's own background. -->
            <div class="flex flex-col gap-4">
              <table class="mh-notch w-full border border-gray-300 bg-gray-50 [--mh-notch-color:var(--color-primary-500)] sm:shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:[--mh-notch-color:var(--color-primary-400)]">
                <thead class="overflow-auto">
                  <tr class="bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 uppercase text-sm leading-normal overflow-auto">
                    <th class="py-3 px-3 md:px-6 text-left wrap-break-word">Number Rolled</th>
                    <th class="py-3 px-3 md:px-6 text-left wrap-break-word">Item</th>
                    <th class="py-3 px-3 md:px-6 text-left wrap-break-word">Part Break Rewards</th>
                  </tr>
                </thead>
                <tbody class="text-gray-800 dark:text-gray-200 text-sm font-light">
                  <tr class="border-b border-gray-300 dark:border-gray-700">
                    <td class="text-left whitespace-nowrap select-none md:select-auto py-3 px-3 md:px-6">1</td>
                    <td class="text-left whitespace-nowrap select-none md:select-auto py-3 px-3 md:px-6"><a href="/wiki.item.show" class="text-gray-900 underline dark:text-parchment">Anjanath Scale</a></td>
                    <td class="text-left whitespace-nowrap select-none md:select-auto py-3 px-3 md:px-6"><span></span></td>
                  </tr>
                </tbody>
                <tfoot></tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer class="border-t border-gray-200 px-4 py-6 sm:px-6 lg:px-8 dark:border-gray-700">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between dark:text-gray-400">
        <p>Not affiliated with Capcom or Steamforged Games.</p>
        <nav class="flex gap-4"><a href="/policy.show" class="hover:text-gray-900 hover:underline dark:hover:text-gray-100">Privacy Policy</a><a href="/terms.show" class="hover:text-gray-900 hover:underline dark:hover:text-gray-100">Terms of Service</a></nav>
      </div>
    </footer>
  </div>
</div>"
`;

