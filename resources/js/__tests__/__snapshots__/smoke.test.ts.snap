    <main>
      <!--v-if-->
      <div class="py-6 sm:py-12">
        <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
          <!-- The weapon as the component prints it: what it brings to the
                     stamina board, what it costs and where it sits in its line. -->
          <div class="mh-card cursor-default gap-3 p-5">
            <div class="flex items-center gap-3"><span class="flex h-10 w-10 min-h-10 min-w-10 items-center justify-center rounded-full bg-gray-300 dark:bg-gray-900"><div class="[&amp;_svg]:h-full [&amp;_svg]:w-full h-5 w-5 text-gray-400 dark:text-gray-300"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240"><g transform="translate(0.000000,240.000000) scale(0.100000,-0.100000)" fill="currentColor"><path d="M1268 1013 c7 -3 16 -2 19 1 4 3 -2 6 -13 5 -11 0 -14 -3 -6 -6z"></path></g><g transform="translate(0.000000,240.000000) scale(0.100000,-0.100000)" fill="currentColor" fill-opacity="0.65"><path d="M1320 2160 c-130 -20 -183 -33 -255 -63 -209 -88 -405 -299 -494 -532 -40 -103 -48 -203 -50 -607 -3 -454 0 -468 80 -468 21 0 71 16 115 36 44 20 99 45 124 56 25 11 59 27 75 35 57 28 156 63 180 63 28 0 59 -36 76 -88 23 -72 71 -162 111 -207 71 -80 143 -105 308 -105 63 0 132 5 153 11 68 18 96 100 62 174 -20 40 -41 50 -136 63 -94 12 -136 40 -173 117 -49 99 -45 180 11 248 28 35 28 54 3 137 -18 54 -21 92 -21 245 0 269 20 365 103 498 59 94 105 162 159 233 21 27 45 66 53 86 14 34 14 38 -5 62 l-20 26 -172 -1 c-108 -1 -215 -8 -287 -19z m258 -63 c-145 -73 -315 -193 -416 -294 -61 -60 -91 -97 -86 -105 4 -7 3 -10 -1 -5 -10 8 -77 -82 -70 -93 3 -4 -1 -10 -9 -13 -8 -3 -22 -30 -32 -59 -16 -46 -19 -104 -23 -456 l-6 -403 -165 -74 c-91 -41 -173 -79 -182 -85 -10 -5 -20 -10 -24 -10 -3 0 -4 210 -2 468 l4 467 33 90 c44 119 64 156 126 240 105 139 252 260 370 304 107 40 289 68 465 70 l104 1 -86 -43z m176 -9 c-4 -7 -27 -38 -50 -69 -88 -115 -204 -303 -223 -363 -31 -92 -44 -235 -40 -439 l4 -184 31 -50 32 -51 -107 -47 c-58 -26 -163 -74 -233 -106 -70 -33 -129 -59 -132 -59 -11 0 -6 718 5 770 34 159 295 398 605 556 59 30 109 54 111 54 2 0 1 -6 -3 -12z m-330 -1344 l6 -42 -96 -61 c-53 -34 -101 -63 -107 -64 -10 -2 -42 101 -34 109 5 5 222 103 223 101 1 -1 4 -21 8 -43z m56 -167 c15 -26 14 -28 -65 -107 -44 -44 -83 -80 -87 -80 -13 0 -70 92 -62 100 28 25 181 119 189 117 5 -2 17 -16 25 -30z m120 -174 l0 -85 -90 4 c-49 2 -93 7 -97 11 -4 4 28 43 71 86 103 104 116 102 116 -16z m178 0 l-3 -78 -42 -3 -43 -3 0 80 0 81 45 0 46 0 -3 -77z M1203 1560 c-98 -59 -74 -210 37 -240 117 -32 213 94 150 197 -37 62 -124 82 -187 43z m109 -77 c10 -9 18 -26 18 -39 0 -24 -33 -54 -59 -54 -23 0 -51 31 -51 56 0 48 55 70 92 37z M1202 1190 c-72 -44 -81 -149 -18 -207 31 -29 43 -33 91 -33 49 0 60 4 91 33 90 82 31 227 -91 227 -23 0 -54 -9 -73 -20z m110 -77 c25 -23 23 -55 -7 -81 -31 -27 -33 -27 -62 0 -57 53 11 134 69 81z"></path></g><g transform="translate(0.000000,240.000000) scale(0.100000,-0.100000)" fill="currentColor" fill-opacity="0.35"><path d="M1608 2235 c-2 -2 -61 -6 -133 -10 -71 -3 -143 -9 -160 -12 -16 -3 -39 -7 -50 -9 -48 -6 -131 -26 -140 -34 -10 -8 -66 -22 -75 -19 -7 3 -123 -63 -135 -77 -5 -6 -26 -21 -45 -34 -37 -24 -200 -186 -200 -199 0 -4 -8 -16 -19 -27 -45 -49 -115 -178 -132 -244 -5 -19 -12 -42 -14 -50 -32 -109 -33 -127 -35 -600 -1 -339 0 -369 18 -414 12 -31 26 -50 37 -52 10 -1 21 -7 24 -12 16 -25 49 -19 156 28 22 9 52 20 66 23 14 4 41 17 60 30 19 13 55 29 81 36 26 8 53 20 59 27 6 8 18 14 26 14 8 0 28 8 43 17 27 15 30 15 54 0 14 -10 29 -30 32 -45 17 -71 122 -247 153 -257 10 -3 27 -14 39 -25 49 -46 117 -61 272 -62 97 0 155 4 175 12 17 7 33 13 36 12 4 -1 16 9 28 22 42 45 47 211 8 250 -9 9 -20 16 -25 16 -6 0 -12 4 -14 10 -1 5 -48 16 -103 25 -56 9 -107 23 -117 32 -22 20 -62 102 -54 110 3 3 1 12 -5 20 -18 21 -3 81 30 119 17 19 31 40 32 47 4 50 -6 107 -23 135 -18 29 -20 49 -19 205 1 267 3 282 48 414 12 36 145 249 163 263 4 3 18 21 31 41 13 20 36 52 52 71 20 26 28 50 32 91 4 53 3 57 -26 78 -24 17 -49 23 -112 26 -45 2 -90 5 -99 7 -9 2 -18 2 -20 1z m191 -81 c19 -24 19 -28 5 -62 -8 -20 -32 -59 -53 -86 -54 -71 -100 -139 -159 -233 -83 -133 -103 -229 -103 -498 0 -153 3 -191 21 -245 25 -83 25 -102 -3 -137 -56 -68 -60 -149 -11 -248 37 -77 79 -105 173 -117 95 -13 116 -23 136 -63 34 -74 6 -156 -62 -174 -21 -6 -90 -11 -153 -11 -165 0 -237 25 -308 105 -40 45 -88 135 -111 207 -17 52 -48 88 -76 88 -24 0 -123 -35 -180 -63 -16 -8 -50 -24 -75 -35 -25 -11 -80 -36 -124 -56 -44 -20 -94 -36 -115 -36 -80 0 -83 14 -80 468 2 404 10 504 50 607 89 233 285 444 494 532 125 53 309 80 542 82 l172 1 20 -26z M1473 2133 c15 -2 37 -2 50 0 12 2 0 4 -28 4 -27 0 -38 -2 -22 -4z M1358 2123 c6 -2 18 -2 25 0 6 3 1 5 -13 5 -14 0 -19 -2 -12 -5z M1288 2113 c7 -3 16 -2 19 1 4 3 -2 6 -13 5 -11 0 -14 -3 -6 -6z M1228 2103 c7 -3 16 -2 19 1 4 3 -2 6 -13 5 -11 0 -14 -3 -6 -6z M1646 2046 c-310 -158 -571 -397 -605 -556 -11 -52 -16 -770 -5 -770 3 0 62 26 132 59 70 32 175 80 233 106 l107 47 -32 51 -31 50 -4 184 c-4 204 9 347 40 439 19 60 135 248 223 363 46 61 59 81 53 81 -2 0 -52 -24 -111 -54z m-305 -481 c77 -41 92 -154 28 -214 -80 -74 -214 -25 -226 82 -12 108 100 182 198 132z m6 -375 c75 -45 84 -148 19 -207 -31 -29 -42 -33 -91 -33 -48 0 -60 4 -91 33 -117 107 27 290 163 207z M1322 1445 c0 -16 2 -22 5 -12 2 9 2 23 0 30 -3 6 -5 -1 -5 -18z M1258 1393 c6 -2 18 -2 25 0 6 3 1 5 -13 5 -14 0 -19 -2 -12 -5z M1258 1023 c6 -2 18 -2 25 0 6 3 1 5 -13 5 -14 0 -19 -2 -12 -5z M889 1943 c-13 -16 -12 -17 4 -4 9 7 17 15 17 17 0 8 -8 3 -21 -13z M1239 1883 c-13 -16 -12 -17 4 -4 9 7 17 15 17 17 0 8 -8 3 -21 -13z M769 1823 c-13 -16 -12 -17 4 -4 9 7 17 15 17 17 0 8 -8 3 -21 -13z M1149 1803 l-34 -38 38 34 c20 19 37 36 37 38 0 8 -8 0 -41 -34z M1079 1723 c-13 -16 -12 -17 4 -4 9 7 17 15 17 17 0 8 -8 3 -21 -13z M943 1415 c0 -33 2 -45 4 -27 2 18 2 45 0 60 -2 15 -4 0 -4 -33z M571 1434 c0 -11 3 -14 6 -6 3 7 2 16 -1 19 -3 4 -6 -2 -5 -13z M562 918 c-2 -391 1 -443 24 -406 4 7 3 8 -4 4 -9 -5 -12 99 -15 406 l-2 413 -3 -417z M1417 711 c-4 -17 -3 -21 5 -13 5 5 8 16 6 23 -3 8 -7 3 -11 -10z M1210 591 c0 -6 4 -13 10 -16 6 -3 7 1 4 9 -7 18 -14 21 -14 7z M1405 468 l-80 -83 83 80 c76 74 87 85 79 85 -1 0 -38 -37 -82 -82z M1265 489 c-4 -6 -5 -12 -2 -15 2 -3 7 2 10 11 7 17 1 20 -8 4z M1593 415 c0 -33 2 -45 4 -27 2 18 2 45 0 60 -2 15 -4 0 -4 -33z M1772 403 c-2 -66 -4 -72 -24 -76 l-23 -4 23 -2 c29 -1 34 12 29 90 l-3 64 -2 -72z M1440 375 c-18 -19 -32 -36 -29 -38 2 -2 19 14 38 35 42 48 36 50 -9 3z M1458 323 c7 -3 16 -2 19 1 4 3 -2 6 -13 5 -11 0 -14 -3 -6 -6z"></path></g></svg></div></span><span class="mh-card-name flex-1 text-xl">Iron Sword</span><span class="mh-value shrink-0 border-attack-line/60 text-attack-line" title="Average damage" aria-label="Average damage">⌀&nbsp;1.3</span><a class="mh-value text-gray-400 dark:text-gray-300" href="/wiki.weapon.type">Rarity 1</a></div>
            <div class="mh-rule"></div>
            <!-- A wiki card has the width for one line, and reads better as one: what
         it protects with, what it hits for, and what the hit carries. A tree
         card does not, so there the effects sit above the damage and the block
         is only as wide as that row, which is what centres it on the card.
         \`contents\` is what lets one set of markup do both: at the wider size
         the two groups dissolve into the outer row and \`order\` decides where
         the damage lands among them. -->
            <div class="flex w-fit flex-wrap items-center gap-x-4 gap-y-2">
              <!--v-if-->
              <div class="contents"><span class="flex items-center gap-1.5 order-2"><span class="relative inline-flex shrink-0 h-8 w-8"><img src="undefined/resources/images/icons/damage-value-icon.png" alt="Damage" class="h-full w-full"><!-- Both symbols are a flat shape around their own centre, the star
                 filled rather than cut out, so the number sits in the middle of
                 the image. --><span class="mh-stat-number absolute inset-0 flex items-center justify-center font-bold leading-none tabular-nums text-sm">1</span></span><span class="mh-value">×2</span></span><span class="flex items-center gap-1.5 order-2"><span class="relative inline-flex shrink-0 h-8 w-8"><img src="undefined/resources/images/icons/damage-value-icon.png" alt="Damage" class="h-full w-full"><!-- Both symbols are a flat shape around their own centre, the star
                 filled rather than cut out, so the number sits in the middle of
                 the image. --><span class="mh-stat-number absolute inset-0 flex items-center justify-center font-bold leading-none tabular-nums text-sm">2</span></span><span class="mh-value">×1</span></span></div>
            </div>
            <!-- Only a hunting horn plays any, and the list printed on
                         its card is what its three songs come from, so the list
                         names this section the way a branch names the materials
                         one. The type's page carries all ten. -->
            <!--v-if-->
            <!-- Most weapons are made one way. Two dual blades can be
                         built from either of two monsters, at different prices. -->
            <h3 class="mh-heading mt-2 text-xs tracking-widest uppercase"><a class="hover:underline" href="/wiki.weapon.type">Anjanath</a><a class="text-parchment-dim hover:underline" href="/wiki.weapon.type"> · Core Box</a></h3>
            <ul class="flex flex-col gap-1 text-sm">
              <li class="flex items-center justify-between gap-3"><a href="/wiki.item.show" class="text-gray-900 hover:underline dark:text-parchment">Anjanath Scale</a><span class="mh-value">3</span></li>
            </ul>
            <!-- What this weapon does to the attack deck, not just what it
                         costs: the cards it takes out and the ones it brings in. -->
            <!--v-if-->
            <div class="mh-rule mt-2"></div>
            <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-600 dark:text-gray-400">
              <!--v-if-->
              <!--v-if-->
            </dl>
          </div>
          <!-- A starting piece is never crafted, so there is nothing here for it to
         say. -->
          <div class="mh-card cursor-default mt-4 gap-3 p-5">
            <h3 class="mh-heading text-xs tracking-widest uppercase">Craft</h3>
            <div><label class="block font-medium text-sm text-gray-700 dark:text-gray-300" for="craft-hunter"><span>Hunter</span></label>
              <!-- An input carries no pseudo elements, so it cannot take the corner
         marks itself. The wrapper draws them over its corners, holding the
         border colour without a border of its own. --><span class="mh-notch relative block [--mh-notch-color:var(--color-gray-400)] focus-within:[--mh-notch-color:var(--color-primary-800)] dark:[--mh-notch-color:var(--color-gray-600)] dark:focus-within:[--mh-notch-color:var(--color-primary-200)] mt-1 block w-full"><select id="craft-hunter" class="mh-field block w-full border border-gray-300 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 focus:border-primary-500 dark:focus:border-primary-600 focus:outline-hidden" value="1"><!--v-if--><option value="1">Rook · Iceborne Crew</option></select></span>
            </div>
            <!--v-if-->
            <!-- Armour has no upgrade tree the way a weapon does, so a second
                 copy buys nothing and there is no point offering it. A weapon
                 can still be built again on top of what is already owned. -->
            <!-- Two dual blades can be built from either of two monsters, at
                     different prices, so the choice of parts is the player's. -->
            <!--v-if--><span class="group relative inline-flex w-full"><button type="button" class="mh-notch inline-flex items-center px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-500 font-semibold text-xs text-gray-700 dark:text-gray-300 uppercase tracking-widest shadow-xs hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-hidden focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 disabled:opacity-25 transition ease-in-out duration-150 w-full justify-center opacity-25" disabled="">Not enough materials</button><!--v-if--></span>
          </div>
        </div>
      </div>
    </main>
    <footer class="border-t border-gray-200 px-4 py-6 sm:px-6 lg:px-8 dark:border-gray-700">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between dark:text-gray-400">
        <p>Not affiliated with Capcom or Steamforged Games.</p>
        <nav class="flex gap-4"><a href="/policy.show" class="hover:text-gray-900 hover:underline dark:hover:text-gray-100">Privacy Policy</a><a href="/terms.show" class="hover:text-gray-900 hover:underline dark:hover:text-gray-100">Terms of Service</a></nav>
      </div>
    </footer>
  </div>
</div>"
`;
