APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
DEBUGBAR_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=monster_hunter_dusk
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120

# CACHE_DRIVER and SESSION_DRIVER here are for the served application only
# (php artisan serve). It reboots the framework fresh on every request, so an
# in-memory driver would lose a login session between one request and the
# next; database survives that. phpunit.dusk.xml sets its own array-driver
# values for the separate Dusk test process, confirmed by direct observation
# to win there (its <env> block is read before this file, so its values are
# already present by the time this file's are considered), and that process
# never serves the browser, so it does not need either to survive a request.
# The two are not supposed to agree, unlike DB_DATABASE above, which both
# processes read the same physical database through and must.
CACHE_DRIVER=file
SESSION_DRIVER=database

# Registration is invitation only in production (AUTH_CAN_REGISTER defaults to
# false). The Dusk suite deliberately covers the open-registration path, so it
# turns the flag on here rather than skipping that coverage.
AUTH_CAN_REGISTER=true

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=null

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google's published test keys: they always verify but never return a score,
# which App\Rules\Recaptcha treats the same as an unreachable Google or a 5xx.
# Public and documented by Google, so safe to commit here.
GOOGLE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_SECRET_SITE_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
